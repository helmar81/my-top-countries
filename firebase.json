{
  "hosting": {
    "source": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "frameworksBackend": {
      "region": "europe-west1"
    },
    "headers": [
      {
        "source": "/_astro/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=31536000, public, immutable"
          }
        ]
      },
      {
        "source": "**/*.{jpg,jpeg,gif,png,webp,svg,ico,woff,woff2,ttf,eot,mp4}",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=31536000, public"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=300, public"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/sitemap.xml",
        "destination": "/sitemap-index.xml",
        "type": 301
      }
    ]
  }
}