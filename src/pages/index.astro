---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import CookieConsent from '../components/CookieConsent.astro';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import { Image } from 'astro:assets';
import hassanImage from '../assets/hassan.webp';
import couscousImage from '../assets/couscous.jpg';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
).slice(0, 3);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<h1>🧑‍🚀 Living in London</h1>
	<div class="content-body">
		<p>
			the ultimate launchpad for global adventures—was a stroke of luck. With six airports at your fingertips—Heathrow, Gatwick, Stansted, Luton, City Airport, and Southend-on-Sea—the world truly feels within reach.
		</p>
		<p>
			There’s nothing like the thrill of travel. Boarding a plane to the unknown, stepping into a new culture, tasting unfamiliar flavors, and hearing stories in accents you’ve never heard before. It’s freedom, curiosity, and discovery all rolled into one.
		</p>
		<p>
			I believe adventure begins the moment you leave your comfort zone—and I hope this blog sparks that fire in you to chase horizons, meet the unexpected, and experience the world in all its raw, beautiful variety.
		</p>
	</div>

	<section class="max-w-6xl mx-auto my-12 px-4 space-y-6">
		<!-- 1. TRAVEL HOOK (Now on Top & Adjusted for Full Width) -->
		<div class="rounded-[1.5rem] bg-slate-950/95 text-white p-6 md:p-8 shadow-[0_24px_80px_rgba(15,23,42,0.12)] border border-white/10">
			<div class="space-y-6">
				<div class="flex items-center gap-3 text-sm uppercase tracking-[0.35em] text-sky-400 font-semibold">
					<span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-sky-500/15">🌍</span>
					<span>Travel Hook</span>
				</div>
				<div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
					<div>
						<p class="text-3xl font-semibold text-white">Chase the next country adventure</p>
						<p class="mt-3 text-sm leading-6 text-slate-300 max-w-2xl">
							The journey from London powers stories of culture, cuisine, and captivating destinations.
						</p>
					</div>
				</div>
				
				<!-- Inner content laid out side-by-side on larger screens -->
				<div class="grid gap-4 md:grid-cols-3 items-stretch">
					<a href="/hook/One-Week-Morocco-Itinerary" class="rounded-3xl bg-white/10 overflow-hidden group block relative aspect-[16/9] md:col-span-2">
						<Image 
							src={hassanImage} 
							alt="One-Week Morocco Itinerary for First-Time Visitors" 
							class="absolute inset-0 w-full h-full object-cover opacity-60 transition-transform duration-500 group-hover:scale-105 group-hover:opacity-50" 
						/>
						<div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-slate-950/20 to-transparent"></div>
						<div class="absolute bottom-4 left-4 right-4 z-10">
							<p class="text-xs uppercase tracking-[0.25em] text-sky-400 font-semibold drop-shadow-md">Your Next Destination</p>
							<p class="mt-1 text-sm font-semibold text-white drop-shadow-md leading-snug">Morocco Itinerary for First-Time Visitors</p>
						</div>
					</a>
					<a href="/hook/Culture-and-Cuisine-in-Morocco" class="rounded-3xl bg-white/10 overflow-hidden group relative flex flex-col justify-end p-6 md:min-h-[250px]">
						<Image 
							src={couscousImage} 
							alt="Culture and Cuisine in Morocco" 
							class="absolute inset-0 w-full h-full object-cover opacity-60 transition-transform duration-500 group-hover:scale-105 group-hover:opacity-50" 
						/>
						<div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-slate-950/20 to-transparent pointer-events-none"></div>
						<div class="relative z-10">
							<p class="text-xs uppercase tracking-[0.25em] text-slate-300 group-hover:text-white transition-colors drop-shadow-md">Trip Focus</p>
							<p class="mt-2 text-2xl font-semibold text-white drop-shadow-md">Culture & Cuisine</p>
						</div>
					</a>
				</div>
			</div>
		</div>

		<!-- 2. MY TOP COUNTRIES (Now below the Travel Hook) -->
		<div class="rounded-[1.5rem] bg-white dark:bg-slate-800 shadow-[0_24px_80px_rgba(15,23,42,0.08)] p-6 md:p-8 border border-slate-200 dark:border-slate-700">
			<div class="space-y-6">
				<div>
					<p class="text-sm uppercase tracking-[0.35em] text-sky-600 font-semibold mb-3">My Top Countries</p>
					<h2 class="text-4xl md:text-5xl font-bold tracking-tight text-slate-950 dark:text-white">76<span class="text-slate-500 dark:text-slate-400">/195</span></h2>
					<p class="mt-4 text-base leading-7 text-slate-600 dark:text-slate-300 max-w-2xl">
						A big travel milestone with even bigger stories: city guides, country highlights, and the places that shaped my journey.
					</p>
				</div>
				<div class="space-y-4">
					<div class="flex items-center justify-between text-sm font-semibold text-slate-700 dark:text-slate-300">
						<span>Progress toward 195</span>
						<span>39%</span>
					</div>
					<div class="h-3 overflow-hidden rounded-full bg-slate-200 dark:bg-slate-700">
						<div class="h-full w-[39%] rounded-full bg-sky-500"></div>
					</div>
				</div>
				<div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
					<a href="/video" class="block rounded-3xl bg-slate-50 dark:bg-slate-800 p-3 sm:p-4 text-center border border-transparent dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
						<p class="text-[10px] sm:text-xs uppercase tracking-[0.15em] sm:tracking-[0.25em] text-slate-500 dark:text-slate-400">Airports</p>
						<p class="mt-1 sm:mt-3 text-xl sm:text-2xl font-semibold text-slate-900 dark:text-white">127</p>
					</a>
					<a href="/countries" class="block rounded-3xl bg-slate-50 dark:bg-slate-800 p-3 sm:p-4 text-center border border-transparent dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
						<p class="text-[10px] sm:text-xs uppercase tracking-[0.15em] sm:tracking-[0.25em] text-slate-500 dark:text-slate-400">Continents</p>
						<p class="mt-1 sm:mt-3 text-xl sm:text-2xl font-semibold text-slate-900 dark:text-white">5</p>
					</a>
					<a href="/blog" class="block rounded-3xl bg-slate-50 dark:bg-slate-800 p-3 sm:p-4 text-center border border-transparent dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
						<p class="text-[10px] sm:text-xs uppercase tracking-[0.15em] sm:tracking-[0.25em] text-slate-500 dark:text-slate-400">Featured Posts</p>
						<p class="mt-1 sm:mt-3 text-xl sm:text-2xl font-semibold text-slate-900 dark:text-white">14+</p>
					</a>
				</div>
				
				<div class="pt-6 border-t border-slate-200 dark:border-slate-700">
					<h3 class="text-xl font-bold mb-4 text-slate-900 dark:text-white">Latest Posts</h3>
					<div class="grid grid-cols-1 sm:grid-cols-3 gap-4 items-stretch">
						{posts.map((post) => (
							<a href={`/blog/${post.id.replace(/\.[^/.]+$/, "")}/`} class="group block h-full bg-slate-50 dark:bg-slate-800/50 rounded-2xl overflow-hidden hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors border border-transparent dark:border-slate-700/50">
								<div class="relative overflow-hidden aspect-[4/3]">
									{post.data.heroImage && (
										<Image 
											width={400} 
											height={300} 
											src={post.data.heroImage} 
											alt={post.data.title} 
											class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105" 
										/>
									)}
								</div>
								<div class="p-4 flex flex-1 flex-col justify-between">
									<div>
										<h4 class="text-sm font-bold mb-1 group-hover:text-sky-600 transition-colors line-clamp-2 text-slate-900 dark:text-white">{post.data.title}</h4>
										<p class="text-[10px] text-slate-500 mb-2 uppercase tracking-wider"><FormattedDate date={post.data.pubDate} /></p>
									</div>
								</div>
							</a>
						))}
					</div>
				</div>
			</div>
		</div>
	</section>

	<div class="flex justify-center mt-8">
		<a href="/blog" class="inline-block px-6 py-3 rounded-2xl bg-blue-100 text-current text-lg shadow-md hover:bg-blue-200 hover:shadow-lg transition duration-300 ease-in-out">
			🌍 My Journey
		</a>
	</div>

	<CookieConsent />
</BaseLayout>