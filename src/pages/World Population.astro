---
import BaseLayout from '../layouts/BaseLayout.astro';
import CountryFlags from '../components/CountryFlags.astro';

const pageTitle = "Where have you been";
---

<BaseLayout title={pageTitle} description="A list of countries I have visited.">
  <main>
    

   

 <section class="population">
      <h2>🌍 World Population (Live)</h2>
