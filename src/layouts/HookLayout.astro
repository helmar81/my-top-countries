---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';

const { frontmatter } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/*.{jpeg,jpg,png,gif,webp}');
const imagePath = frontmatter.heroImage ? frontmatter.heroImage.replace('../../assets/', '/src/assets/') : null;
---

<BaseLayout title={frontmatter.title} description={frontmatter.description}>
  <div class="max-w-4xl mx-auto px-4 py-8">
    <article class="prose lg:prose-xl dark:prose-invert max-w-none prose-img:rounded-xl prose-img:shadow-lg prose-headings:text-primary">
      {imagePath && images[imagePath] && (
        <Image 
          src={images[imagePath]()} 
          alt={frontmatter.title} 
          class="w-full h-[40vh] md:h-[60vh] object-cover rounded-3xl shadow-2xl mb-10" 
        />
      )}
      <h1 class="text-4xl md:text-6xl font-extrabold text-center mb-12">{frontmatter.title}</h1>
      <slot />
    </article>
    
    <div class="mt-16 mb-8 text-center">
      <a 
        href="/blog" 
        class="inline-block bg-primary hover:bg-blue-800 text-white font-bold text-lg py-4 px-10 rounded-full transition-all duration-300 transform hover:scale-105 shadow-xl"
      >
        Read the Blog
      </a>
    </div>
  </div>
</BaseLayout>
