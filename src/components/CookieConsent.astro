---
---
<div id="cookie-consent" class="fixed inset-x-0 bottom-0 bg-gray-900 text-white px-4 py-3 pb-[calc(0.875rem+env(safe-area-inset-bottom,0px))] flex flex-col gap-2 md:flex-row md:items-center md:justify-between md:px-5 md:py-4 md:gap-3 z-50 transition-transform transform translate-y-full" style="display: none;">
  <p class="text-sm leading-5 md:leading-6 md:mb-0">
    We use cookies to improve your experience. You can accept or decline.
  </p>
  <div class="flex flex-wrap gap-2">
    <button id="accept-cookies" class="bg-green-400 hover:bg-green-500 text-black font-bold py-1.5 px-3 rounded text-sm">
      Accept
    </button>
    <button id="decline-cookies" class="bg-red-400 hover:bg-red-500 text-black font-bold py-1.5 px-3 rounded text-sm">
      Decline
    </button>
  </div>
</div>

<script type="module" is:inline>
  const consentBanner = document.getElementById('cookie-consent');
  const acceptButton = document.getElementById('accept-cookies');
  const declineButton = document.getElementById('decline-cookies');

  if (!localStorage.getItem('cookie_consent')) {
    consentBanner.style.display = 'flex';
    setTimeout(() => {
      consentBanner.classList.remove('translate-y-full');
    }, 100);
  } else {
    document.dispatchEvent(new CustomEvent('cookie-consent', {
      detail: localStorage.getItem('cookie_consent')
    }));
  }

  acceptButton?.addEventListener('click', () => {
    localStorage.setItem('cookie_consent', 'true');
    hideBanner();
    document.dispatchEvent(new CustomEvent('cookie-consent', { detail: 'true' }));
  });

  declineButton?.addEventListener('click', () => {
    localStorage.setItem('cookie_consent', 'false');
    hideBanner();
    document.dispatchEvent(new CustomEvent('cookie-consent', { detail: 'false' }));
  });

  function hideBanner() {
    consentBanner.classList.add('translate-y-full');
    setTimeout(() => {
      consentBanner.style.display = 'none';
    }, 300);
  }
</script>
