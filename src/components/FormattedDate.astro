---
interface Props {
  date: string | Date; // Accept either a string or a Date object
}

const { date } = Astro.props;

// Force convert it into a valid Date object
const dateObj = typeof date === 'string' ? new Date(date) : date;
---

<time datetime={dateObj.toISOString()}>
  {
    dateObj.toLocaleDateString('en-us', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
    })
  }
</time>