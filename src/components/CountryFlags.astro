---
import "flag-icons/css/flag-icons.min.css";
import countryNames from "../data/countries.json" assert { type: "json" };

const countryCodes = Object.keys(countryNames);
---

<div>
  <div class="container">
    <div class="section">
      <h2>All Countries</h2>

      <!-- Search and Filter Controls -->
      <div class="controls">
        <input
          id="search-input"
          type="text"
          placeholder="Search countries..."
          class="search-bar"
        />
        <select id="continent-filter" class="filter-select">
          <option value="">All Continents</option>
          <option value="europe">Europe</option>
          <option value="asia">Asia</option>
          <option value="africa">Africa</option>
          <option value="north-america">North America</option>
          <option value="south-america">South America</option>
          <option value="oceania">Oceania</option>
        </select>
      </div>

      <!-- Toggle buttons for mobile -->
      <div class="mobile-controls">
        <button id="toggle-mode" class="toggle-btn">📱 Switch to Button Mode</button>
        <button id="select-all" class="action-btn">Select All Visible</button>
        <button id="move-selected" class="action-btn" disabled>Move Selected</button>
      </div>

      <div id="all-countries" class="flags-container">
        {countryCodes.map(code => (
          <div
            class="flag-item"
            draggable="true"
            data-code={code}
            data-name={countryNames[code].toLowerCase()}
          >
            <input type="checkbox" class="flag-checkbox" style="display: none;" />
            <div class="flag-content">
              <span class={`fi fi-${code.toLowerCase()}`}></span>
              <span class="country-name">{countryNames[code]}</span>
            </div>
            <button class="move-btn" style="display: none;">➤</button>
          </div>
        ))}
      </div>

      <!-- Pagination for better performance -->
      <div class="pagination">
        <button id="load-more" class="load-more-btn">Load More Countries</button>
        <span id="showing-count" class="count-text">Showing 50 of {countryCodes.length}</span>
      </div>
    </div>

    <div class="section">
      <h2>Visited Countries</h2>
      <div class="visited-header">
        <p id="visited-count">Visited: 0</p>
        <button id="clear-all" class="clear-btn">Clear All</button>
      </div>
      <div id="visited-countries" class="flags-container drop-zone">
        <div class="drop-message">
          <p>Drag countries here or use button mode to mark as visited</p>
        </div>
      </div>
    </div>
  </div>

  <button id="reset-button" class="reset-button">Reset All Countries</button>
</div>

<style>
  :host {
    display: block;
    max-width: 1000px;
    margin: 2rem auto;
    padding: 1rem;
    background: #fafafa;
    border: 1px solid #eee;
    border-radius: 12px;
    box-shadow: 0 2px 6px rgba(0,0,0,0.05);
  }

  .container {
    display: grid;
    gap: 20px;
  }

  @media (min-width: 768px) {
    .container { 
      grid-template-columns: 1fr 1fr;
    }
  }

  .section {
    border: 1px solid #e5e5e5;
    background: white;
    padding: 15px;
    border-radius: 10px;
    box-shadow: 0 1px 4px rgba(0,0,0,0.03);
    max-height: 70vh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  h2 {
    margin-top: 0;
    text-align: center;
    font-size: 1.2rem;
    color: #444;
    flex-shrink: 0;
  }

  .controls {
    display: flex;
    gap: 10px;
    margin-bottom: 15px;
    flex-shrink: 0;
  }

  .search-bar, .filter-select {
    flex: 1;
    padding: 10px 12px;
    border: 1px solid #ccc;
    border-radius: 8px;
    font-size: 1rem;
    min-height: 42px;
  }

  .mobile-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 15px;
    flex-wrap: wrap;
    flex-shrink: 0;
  }

  .toggle-btn, .action-btn, .clear-btn {
    padding: 8px 12px;
    border: 1px solid #007bff;
    background: #007bff;
    color: white;
    border-radius: 6px;
    cursor: pointer;
    font-size: 0.9rem;
    transition: all 0.2s;
  }

  .toggle-btn:hover, .action-btn:hover, .clear-btn:hover {
    background: #0056b3;
  }

  .action-btn:disabled {
    background: #6c757d;
    border-color: #6c757d;
    cursor: not-allowed;
  }

  .flags-container {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
    padding: 10px;
    overflow-y: auto;
    flex: 1;
    scrollbar-width: thin;
  }

  .flags-container::-webkit-scrollbar {
    width: 8px;
  }

  .flags-container::-webkit-scrollbar-thumb {
    background: #ccc;
    border-radius: 4px;
  }

  .flag-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
    cursor: grab;
    width: 90px;
    text-align: center;
    padding: 8px;
    border-radius: 8px;
    transition: all 0.2s;
    position: relative;
    border: 2px solid transparent;
  }

  .flag-item:hover {
    background: #f0f8ff;
    transform: translateY(-2px);
  }

  .flag-item.dragging {
    opacity: 0.5;
    transform: rotate(5deg);
  }

  .flag-item.selected {
    border-color: #007bff;
    background: #e3f2fd;
  }

  .flag-item.button-mode {
    cursor: pointer;
  }

  .flag-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
    pointer-events: none;
  }

  .flag-checkbox {
    position: absolute;
    top: 4px;
    right: 4px;
    width: 16px;
    height: 16px;
    cursor: pointer;
  }

  .move-btn {
    position: absolute;
    top: 4px;
    right: 4px;
    width: 24px;
    height: 24px;
    border: none;
    background: #28a745;
    color: white;
    border-radius: 50%;
    cursor: pointer;
    font-size: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .flags-container span.fi {
    font-size: 2.5rem;
    border-radius: 4px;
    transition: transform 0.2s;
  }

  .flag-item:hover span.fi {
    transform: scale(1.1);
  }

  .country-name {
    font-size: 0.8rem;
    font-weight: 500;
    word-break: break-word;
    line-height: 1.2;
  }

  .drop-zone {
    min-height: 150px;
    background: linear-gradient(145deg, #f9f9f9 0%, #e8f5e8 100%);
    border: 2px dashed #ccc;
    border-radius: 8px;
    position: relative;
    transition: all 0.3s;
  }

  .drop-zone.drag-over {
    border-color: #28a745;
    background: linear-gradient(145deg, #e8f5e8 0%, #d4edda 100%);
    transform: scale(1.02);
  }

  .drop-message {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    color: #6c757d;
    font-style: italic;
    pointer-events: none;
  }

  .visited-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
    flex-shrink: 0;
  }

  #visited-count {
    margin: 0;
    font-weight: bold;
    color: #28a745;
  }

  .pagination {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 15px;
    padding-top: 15px;
    border-top: 1px solid #eee;
    flex-shrink: 0;
  }

  .load-more-btn, .reset-button {
    padding: 10px 20px;
    border: 1px solid #6c757d;
    background: white;
    color: #6c757d;
    border-radius: 6px;
    cursor: pointer;
    font-size: 1rem;
    transition: all 0.2s;
  }

  .load-more-btn:hover, .reset-button:hover {
    background: #6c757d;
    color: white;
  }

  .count-text {
    font-size: 0.9rem;
    color: #6c757d;
  }

  .reset-button {
    margin-top: 20px;
    display: block;
    margin-left: auto;
    margin-right: auto;
  }

  /* Mobile-specific improvements */
  @media (max-width: 767px) {
    :host {
      margin: 1rem;
      padding: 0.5rem;
    }

    .container {
      grid-template-columns: 1fr;
    }

    .controls {
      flex-direction: column;
      gap: 8px;
    }

    .flag-item {
      width: 80px;
      min-height: 80px;
      touch-action: none;
    }

    .flags-container {
      gap: 6px;
      padding: 8px;
    }

    .flags-container span.fi {
      font-size: 2rem;
    }

    .country-name {
      font-size: 0.7rem;
    }

    /* Larger touch targets on mobile */
    .flag-checkbox, .move-btn {
      width: 28px;
      height: 28px;
    }

    .mobile-controls {
      justify-content: center;
    }

    .toggle-btn, .action-btn {
      flex: 1;
      min-width: 100px;
    }
  }

  /* Ultra-mobile (very small screens) */
  @media (max-width: 480px) {
    .flag-item {
      width: 70px;
    }

    .flags-container span.fi {
      font-size: 1.8rem;
    }

    .country-name {
      font-size: 0.65rem;
    }
  }

  /* Improved accessibility */
  @media (prefers-reduced-motion: reduce) {
    * {
      transition: none !important;
      animation: none !important;
    }
  }
</style>

<script>
  let currentMode = 'drag'; // 'drag' or 'button'
  let selectedCountries = new Set();
  let displayedCount = 50;
  let allFlags = [];

  function speakCountryName(code) {
    const flagItem = document.querySelector(`.flag-item[data-code="${code}"]`);
    const countryName = flagItem?.querySelector('.country-name')?.textContent;
    if (countryName && 'speechSynthesis' in window) {
      window.speechSynthesis.speak(new SpeechSynthesisUtterance(countryName));
    }
  }

  function toggleMode() {
    const toggleBtn = document.getElementById("toggle-mode");
    const moveSelectedBtn = document.getElementById("move-selected");
    const allFlags = document.querySelectorAll<HTMLElement>(".flag-item");

    if (currentMode === 'drag') {
      // Switch to button mode
      currentMode = 'button';
      if (toggleBtn) {
        toggleBtn.textContent = '🖱️ Switch to Drag Mode';
      }
      
      allFlags.forEach(flag => {
        flag.draggable = false;
        flag.classList.add('button-mode');
        const checkbox = flag.querySelector<HTMLInputElement>('.flag-checkbox');
        if (checkbox) checkbox.style.display = 'block';
        const moveBtn = flag.querySelector<HTMLButtonElement>('.move-btn');
        if (moveBtn) moveBtn.style.display = 'flex';
      });
      
      if (moveSelectedBtn) {
        moveSelectedBtn.style.display = 'inline-block';
      }
    } else {
      // Switch to drag mode
      currentMode = 'drag';
      if (toggleBtn) {
        toggleBtn.textContent = '📱 Switch to Button Mode';
      }
      
      allFlags.forEach(flag => {
        flag.draggable = true;
        flag.classList.remove('button-mode', 'selected');
        const checkbox = flag.querySelector<HTMLInputElement>('.flag-checkbox');
        if (checkbox) checkbox.style.display = 'none';
        const moveBtn = flag.querySelector<HTMLButtonElement>('.move-btn');
        if (moveBtn) moveBtn.style.display = 'none';
      });
      
      if (moveSelectedBtn) {
        moveSelectedBtn.style.display = 'none';
      }
      selectedCountries.clear();
      updateMoveButton();
    }
  }

  function updateMoveButton() {
    const moveBtn = document.getElementById("move-selected");
    if (moveBtn) {
      (moveBtn as HTMLButtonElement).disabled = selectedCountries.size === 0;
      moveBtn.textContent = `Move Selected (${selectedCountries.size})`;
    }
  }

  function showFlags(count) {
    const container = document.getElementById("all-countries");
    const flags = allFlags.slice(0, count);
    
    if (container) {
      // Clear existing flags
      container.querySelectorAll('.flag-item').forEach(item => item.remove());
      
      // Add flags up to count
      flags.forEach(flag => container.appendChild(flag));
    }
    
    // Update pagination
    const showingCount = document.getElementById("showing-count");
    const loadMoreBtn = document.getElementById("load-more");
    
    if (showingCount) {
      showingCount.textContent = `Showing ${Math.min(count, allFlags.length)} of ${allFlags.length}`;
    }
    
    if (loadMoreBtn) {
      loadMoreBtn.style.display = count >= allFlags.length ? 'none' : 'block';
    }
  }

  function moveCountryToVisited(flagElement) {
    const visitedCountries = document.getElementById("visited-countries");
    const dropMessage = visitedCountries?.querySelector('.drop-message');
    
    if (visitedCountries) {
      if (dropMessage && visitedCountries.children.length === 1) {
        (dropMessage as HTMLElement).style.display = 'none';
      }
      
      visitedCountries.appendChild(flagElement);
      flagElement.classList.remove('selected');
      flagElement.querySelector('.flag-checkbox').checked = false;
      
      selectedCountries.delete(flagElement.dataset.code);
      updateMoveButton();
      updateCount();
      saveVisitedCountries();
    }
  }

  function updateCount() {
    const visitedCount = document.getElementById("visited-count");
    const visitedCountries = document.getElementById("visited-countries");
    if (visitedCount && visitedCountries) {
      const count = visitedCountries.querySelectorAll(".flag-item").length;
      visitedCount.textContent = `Visited: ${count}`;
      
      // Show/hide drop message
      const dropMessage = visitedCountries.querySelector('.drop-message');
      if (dropMessage) {
        (dropMessage as HTMLElement).style.display = count === 0 ? 'block' : 'none';
      }
    }
  }

  function saveVisitedCountries() {
    const visitedCountries = document.getElementById("visited-countries");
    if (visitedCountries) {
      const codes = Array.from(visitedCountries.querySelectorAll(".flag-item"))
        .map(f => (f as HTMLElement).dataset.code);
      localStorage.setItem("visitedCountries", JSON.stringify(codes));
    }
  }

  function addTouchSupport(element) {
    let startY = 0;
    let startX = 0;
    let isDragging = false;
    
    element.addEventListener('touchstart', (e) => {
      if (currentMode !== 'drag') return;
      
      const touch = e.touches[0];
      startX = touch.clientX;
      startY = touch.clientY;
      isDragging = false;
      
      element.classList.add('dragging');
    }, { passive: true });
    
    element.addEventListener('touchmove', (e) => {
      if (currentMode !== 'drag') return;
      
      const touch = e.touches[0];
      const deltaX = Math.abs(touch.clientX - startX);
      const deltaY = Math.abs(touch.clientY - startY);
      
      if (deltaX > 10 || deltaY > 10) {
        isDragging = true;
      }
    }, { passive: true });
    
    element.addEventListener('touchend', (e) => {
      if (currentMode !== 'drag') return;
      
      element.classList.remove('dragging');
      
      if (!isDragging) return;
      
      const touch = e.changedTouches[0];
      const elementBelow = document.elementFromPoint(touch.clientX, touch.clientY);
      const dropZone = elementBelow?.closest('.drop-zone');
      
      if (dropZone && dropZone.id === 'visited-countries') {
        moveCountryToVisited(element);
      }
    }, { passive: true });
  }

  document.addEventListener("DOMContentLoaded", () => {
    const allCountries = document.getElementById("all-countries");
    const visitedCountries = document.getElementById("visited-countries");
    const searchInput = document.getElementById("search-input");
    const continentFilter = document.getElementById("continent-filter");
    const toggleBtn = document.getElementById("toggle-mode");
    const selectAllBtn = document.getElementById("select-all");
    const moveSelectedBtn = document.getElementById("move-selected");
    const loadMoreBtn = document.getElementById("load-more");
    const clearAllBtn = document.getElementById("clear-all");

    // Store all flags for pagination
    if (allCountries) {
      allFlags = Array.from(allCountries.querySelectorAll('.flag-item'));
      showFlags(displayedCount);
    }

    // Restore visited countries
    const saved = JSON.parse(localStorage.getItem("visitedCountries") || "[]");
    saved.forEach(code => {
      const flag = document.querySelector(`.flag-item[data-code="${code}"]`);
      if (flag && visitedCountries) {
        visitedCountries.appendChild(flag);
      }
    });
    updateCount();

    // Add event listeners to all flags
    function setupFlagListeners() {
      document.querySelectorAll<HTMLElement>(".flag-item").forEach(flag => {
        // Drag events
          flag.addEventListener("dragstart", (e) => {
          const dragEvent = e as DragEvent;
          dragEvent.dataTransfer?.setData("text/plain", flag.dataset.code || "");
          flag.classList.add('dragging');
        });
        
        flag.addEventListener("dragend", () => {
          flag.classList.remove('dragging');
        });

        // Click for speech
        flag.addEventListener("click", (e) => {
          if (currentMode === 'drag' && !(e.target as Element).closest('.flag-checkbox, .move-btn')) {
            speakCountryName(flag.dataset.code || "");
          }
        });

        // Checkbox handling
        const checkbox = flag.querySelector('.flag-checkbox') as HTMLInputElement | null;
        checkbox?.addEventListener('change', (e) => {
          e.stopPropagation();
          if (checkbox && checkbox.checked) {
            selectedCountries.add(flag.dataset.code);
            flag.classList.add('selected');
          } else {
            selectedCountries.delete((flag as HTMLElement).dataset.code);
            flag.classList.remove('selected');
          }
          updateMoveButton();
        });

        // Individual move button
        const moveBtn = flag.querySelector('.move-btn');
        moveBtn?.addEventListener('click', (e) => {
          e.stopPropagation();
          moveCountryToVisited(flag);
        });

        // Add touch support
        addTouchSupport(flag);
      });
    }

    setupFlagListeners();

    // Drop zone events
    visitedCountries?.addEventListener("dragover", (e) => {
      e.preventDefault();
      visitedCountries.classList.add('drag-over');
    });

    visitedCountries?.addEventListener("dragleave", () => {
      visitedCountries.classList.remove('drag-over');
    });

    visitedCountries?.addEventListener("drop", (e) => {
      e.preventDefault();
      visitedCountries.classList.remove('drag-over');
      
      const code = e.dataTransfer?.getData("text/plain");
      const dragged = document.querySelector(`.flag-item[data-code="${code}"]`);
      
      if (dragged) {
        moveCountryToVisited(dragged);
      }
    });

    // Mode toggle
    toggleBtn?.addEventListener("click", toggleMode);

    // Select all visible
    selectAllBtn?.addEventListener("click", () => {
      const visibleFlags = Array.from(
        allCountries?.querySelectorAll<HTMLElement>('.flag-item') ?? []
      ).filter(flag => flag.style.display !== 'none');
      
      visibleFlags.forEach(flag => {
        const checkbox = flag.querySelector<HTMLInputElement>('.flag-checkbox');
        if (checkbox && !checkbox.checked) {
          checkbox.checked = true;
          const code = flag.dataset.code;
          if (code) {
            selectedCountries.add(code);
          }
          flag.classList.add('selected');
        }
      });
      updateMoveButton();
    });

    // Move selected
    moveSelectedBtn?.addEventListener("click", () => {
      selectedCountries.forEach(code => {
        const flag = document.querySelector(`.flag-item[data-code="${code}"]`);
        if (flag) {
          moveCountryToVisited(flag);
        }
      });
    });

    // Load more
    loadMoreBtn?.addEventListener("click", () => {
      displayedCount += 50;
      showFlags(displayedCount);
      setupFlagListeners(); // Re-setup listeners for new flags
    });

    // Clear all visited
    clearAllBtn?.addEventListener("click", () => {
      visitedCountries?.querySelectorAll(".flag-item").forEach(flag => {
        allCountries?.appendChild(flag);
      });
      updateCount();
      saveVisitedCountries();
      
      // Re-apply current display filters
      if ((searchInput as HTMLInputElement)?.value) {
        if (searchInput) {
          searchInput.dispatchEvent(new Event('input'));
        }
      }
    });

    // Reset button
    document.getElementById("reset-button")?.addEventListener("click", () => {
      localStorage.removeItem("visitedCountries");
      visitedCountries?.querySelectorAll(".flag-item").forEach(flag => {
        allCountries?.appendChild(flag);
      });
      selectedCountries.clear();
      updateMoveButton();
      updateCount();
      
      // Reset display
      displayedCount = 50;
      showFlags(displayedCount);
      setupFlagListeners();
    });

    // Search functionality
    searchInput?.addEventListener("input", () => {
      const query = (searchInput as HTMLInputElement).value.toLowerCase();
      document.querySelectorAll(".flag-item").forEach(flag => {
        const name = flag.getAttribute("data-name");
        if (name && name.includes(query)) {
          (flag as HTMLElement).style.display = "flex";
        } else {
          (flag as HTMLElement).style.display = "none";
        }
      });
    });

    // Auto-scroll when dragging near edges
    let scrollInterval;
    document.addEventListener('dragover', (e) => {
      const container = (e.target as Element)?.closest('.flags-container');
      if (!container) return;
      
      const rect = container.getBoundingClientRect();
      const scrollThreshold = 50;
      
      clearInterval(scrollInterval);
      
      if (e.clientY - rect.top < scrollThreshold) {
        scrollInterval = setInterval(() => {
          container.scrollTop -= 10;
        }, 50);
      } else if (rect.bottom - e.clientY < scrollThreshold) {
        scrollInterval = setInterval(() => {
          container.scrollTop += 10;
        }, 50);
      }
    });
    
    document.addEventListener('dragend', () => {
      clearInterval(scrollInterval);
    });
  });
</script>