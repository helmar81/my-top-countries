---
import HeaderLink from './HeaderLink.astro';
import DarkModeToggle from './DarkModeToggle.jsx';
import { SITE_TITLE } from '../consts';
import { Image } from 'astro:assets';
import iconImage from '../assets/icon.png';
---

<header>

	<nav class="bg-white border-gray-200 px-2 sm:px-4 py-2.5 rounded dark:bg-gray-900 shadow-md sticky top-0 z-50" >

    
  <div class="container flex flex-wrap items-center justify-between mx-auto">
    <a href="/" class="flex items-center">
        <Image src={iconImage} class="h-6 w-auto mr-3 sm:h-9" alt="Logo" />
       
        <span class="self-center text-lg sm:text-xl font-semibold whitespace-nowrap dark:text-white">{SITE_TITLE}</span>

    </a>
    <input id="mobile-menu-toggle" type="checkbox" class="peer hidden" aria-hidden="true" />
    
    <div class="flex items-center gap-2 md:order-2">
      <DarkModeToggle client:idle />
      <label for="mobile-menu-toggle" class="inline-flex items-center p-2 text-sm text-gray-500 rounded-lg md:hidden hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-gray-200 dark:text-gray-400 dark:hover:bg-gray-700 dark:focus:ring-gray-600 cursor-pointer" aria-label="Toggle navigation">
        <span class="sr-only">Open main menu</span>
        <svg class="w-6 h-6" aria-hidden="true" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 10a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 15a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z" clip-rule="evenodd"></path></svg>
      </label>
    </div>

    <div class="w-full md:block md:w-auto md:order-1" id="navbar-default">
      <ul class="text-base md:text-sm flex flex-col p-4 mt-4 border border-gray-100 rounded-lg bg-gray-50 md:flex-row md:space-x-8 md:mt-0 md:text-sm md:font-medium md:border-0 md:bg-white dark:bg-gray-800 md:dark:bg-gray-900 dark:border-gray-700">
        <li>
          <HeaderLink href="/">Home</HeaderLink>
        </li>
       
        <li>
          <HeaderLink href="/countries">Countries</HeaderLink>
        </li>
       
        <li>
          <HeaderLink href="/video">Videos</HeaderLink>
        </li>
        
      </ul>
    </div>
  </div>
</nav>
</header>
<style>
  #navbar-default {
    transition: all 0.3s ease-in-out;
  }

  @media (max-width: 768px) {
    #navbar-default {
      display: none;
    }
    #mobile-menu-toggle:checked ~ #navbar-default {
      display: block !important;
    }
    #navbar-default:not(.hidden) {
      animation: slideDown 0.3s ease-in-out forwards;
    }
  }

  @media (min-width: 768px) {
    #navbar-default {
      display: block !important;
    }
  }

  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
